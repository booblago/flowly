AUTH_SECRET=replace-with-a-long-random-string
# Local: http://localhost:3000  ·  Vercel: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Owner-only /admin accounts console
OWNER_EMAIL=you@example.com
# Recreates owner after Vercel DB wipe. Set the same value in Vercel → Settings → Environment Variables.
# OWNER_PASSWORD=your-strong-password
# Set to 1 once to force-reset owner password from OWNER_PASSWORD, then remove.
# OWNER_RESET_PASSWORD=1

# Set automatically on Vercel. Force memory DB locally with FLOWLY_MEMORY_DB=1
# FLOWLY_MEMORY_DB=1

# Optional but recommended on Vercel for durable shared DB (survives cache eviction).
# Vercel → Storage → Create → Upstash Redis → Connect to this project
# Without it, production falls back to Vercel Runtime Cache (shared, but ephemeral).
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Optional: real verification emails (https://resend.com)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Flowly <onboarding@yourdomain.com>

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# Optional: Price ID from Stripe Products. If omitted, Checkout uses $12/mo inline price_data.
STRIPE_PRICE_ID=price_...
# Webhook signing secret from `stripe listen --forward-to localhost:3000/api/billing/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...
