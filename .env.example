AUTH_SECRET=replace-with-a-long-random-string
# Local: http://localhost:3000  ·  Vercel: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Owner-only /admin accounts console
OWNER_EMAIL=you@example.com

# Set automatically on Vercel. Force memory DB locally with FLOWLY_MEMORY_DB=1
# FLOWLY_MEMORY_DB=1

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# Optional: Price ID from Stripe Products. If omitted, Checkout uses $12/mo inline price_data.
STRIPE_PRICE_ID=price_...
# Webhook signing secret from `stripe listen --forward-to localhost:3000/api/billing/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...
